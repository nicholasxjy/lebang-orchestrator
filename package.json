{
  "name": "lebang-orchestrator",
  "version": "0.1.0",
  "description": "Small, observable, git-native orchestration for Pi coding agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "orchestrator": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    ".orchestrator/config.json",
    "README.md",
    "LICENSE",
    "Plan.md"
  ],
  "pi": {
    "extensions": [
      "dist/extension.js"
    ],
    "skills": [
      "skills"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-cli-executable.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
